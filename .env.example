# Configuration
# Copy this file to .env and fill in your values
#
# Forseti non richiede variabili d'ambiente per funzionare: è uno strumento
# CLI locale che legge/scrive solo file YAML e Markdown sul filesystem.
# Questo file è incluso per coerenza con gli altri moduli della suite Asgard
# ed è pronto per future estensioni (es. integrazioni opzionali).

# Optional
LOG_LEVEL=INFO
DEBUG=false
